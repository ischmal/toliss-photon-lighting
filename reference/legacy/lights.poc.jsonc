// ============================================================================
// ToLiss Photon Lighting — Phase II config (schema v3) — SUPERSEDED
// ============================================================================
// !! This file has been replaced by the DSL pair lights.style + lights.layout
// !! (see dsl.md). It is kept as a frozen reference of the migration source;
// !! the build only reads it if the DSL files are missing. DO NOT EDIT.
// ============================================================================
// Arranged by concern: palettes -> categories (which profile is "original") ->
// lightTypes (appearance: class + color + per-profile intensity + cone) ->
// mounts -> airframes (placement + gating). Objects with 2+ properties are
// one-per-line; number arrays and single-property objects stay inline.
// color is stated explicitly on every light type (nav wingtips are per-side).
//
// Verify:  python build/build_objs.py check --airframe a320
{
  "schema": 3,
  // -- PALETTES: rgb per profile (halogen/xenon/led) x color x bb/sp --
  "palettes": {
    "led": {
      "white": {
        "bb": [0.66, 0.91, 1],
        "sp": [0.66, 0.91, 1]
      },
      "red": {
        "bb": [1, 0.03, 0],
        "sp": [1, 0.03, 0]
      },
      "green": {
        "bb": [0.06, 1, 0],
        "sp": [0.06, 1, 0]
      }
    },
    "halogen": {
      "white": {
        "bb": [1, 0.7, 0.44],
        "sp": [1, 0.7, 0.44]
      },
      "red": {
        "bb": [1, 0.15, 0.07],
        "sp": [1, 0.15, 0.07]
      },
      "green": {
        "bb": [0.12, 0.77, 0.25],
        "sp": [0.12, 0.77, 0.25]
      }
    },
    "xenon": {
      "white": {
        "bb": [0.45, 0.45, 1],
        "sp": [0.75, 0.75, 1]
      },
      "red": {
        "bb": [1, 0.03, 0.05],
        "sp": [1, 0.03, 0.05]
      }
    }
  },
  // -- CATEGORIES: `original` = palette for the dataref=0 branch --
  "categories": {
    "nav": { "original": "halogen" },
    "strobe": { "original": "xenon" },
    "beacon": { "original": "xenon" },
    "landing": { "original": "halogen" },
    "taxi": { "original": "halogen" },
    "to": { "original": "halogen" },
    "rwyturnoff": { "original": "halogen" },
    "wing": { "original": "halogen" },
    "logo": { "original": "halogen" }
  },
  // -- LIGHT TYPES (appearance): class + color + per-profile intensity + cone --
  "lightTypes": {
    "nav_tail_bb": {
      "class": "airplane_nav_bb",
      "color": "white",
      "intensity": {
        "halogen": 600,
        "led": 600
      },
      "cone": 0.1,
      "dir": [0, 0, 1]
    },
