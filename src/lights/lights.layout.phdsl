// ============================================================================
// ToLiss Photon Lighting — Phase II document (placement)
// ============================================================================
// Mounts (verbatim transform-snippet files) and per-airframe fixtures: the
// lights, their positions/directions, and gating. Appearance lives in
// lights.style.phdsl. Full syntax spec: docs/dsl.md.
//
// `airframe X extends Y` starts from Y's fixtures; overrides target lights by
// NAME: `<fixture> <group> <light> { pos: ...; }` (labels like nav_marker#up
// disambiguate duplicates within a group).
//
// Verify:  python build/build_objs.py check --airframe a320

// -- MOUNTS: verbatim transform-stack snippet files --
mounts a320 {
  beacon_fus { stock: src/lights/mounts/a320/beacon_fus.stock.obj; }
  logo_fus { stock: src/lights/mounts/a320/logo_fus.stock.obj; }
  gear_left {
    stock: src/lights/mounts/a320/gear_left.stock.obj;
    durantula: src/lights/mounts/a320/gear_left.durantula.obj;
    realwings: src/lights/mounts/a320/gear_left.realwings.obj;
  }
  gear_right {
    stock: src/lights/mounts/a320/gear_right.stock.obj;
    durantula: src/lights/mounts/a320/gear_right.durantula.obj;
    realwings: src/lights/mounts/a320/gear_right.realwings.obj;
  }
  nosegear { stock: src/lights/mounts/a320/nosegear.stock.obj; }
  wing_left {
    stock: src/lights/mounts/a320/wing_left.stock.obj;
    durantula: src/lights/mounts/a320/wing_left.durantula.obj;
  }
  wing_right {
    stock: src/lights/mounts/a320/wing_right.stock.obj;
    durantula: src/lights/mounts/a320/wing_right.durantula.obj;
  }
  // Interior: the four movable main panel flood lamps. Each is a z/x/y
  // ANIM_trans stack driven by ckpt/lights/<n>/{x,y,z}/dir, transcribed
  // verbatim (Gus's file and stock ToLiss's are byte-identical here).
  // Stock-only: wing mods do not touch the cockpit.
  panelflood1 { stock: src/lights/mounts/a320/panelflood1.stock.obj; }
  panelflood2 { stock: src/lights/mounts/a320/panelflood2.stock.obj; }
  panelflood3 { stock: src/lights/mounts/a320/panelflood3.stock.obj; }
  panelflood4 { stock: src/lights/mounts/a320/panelflood4.stock.obj; }
}
mounts a321 {
  beacon_fus { stock: src/lights/mounts/a321/beacon_fus.stock.obj; }
  tail_fus { stock: src/lights/mounts/a321/tail_fus.stock.obj; }
}

// A330-900 mounts: no wing mods exist for this airframe, so every mount is
// stock-only. Wingtip nav/strobe sit inside the full 10-level WingFlex[0..9]
// rotate/counter-rotate chain (wingtip_left/right); landing lights only need
// the first WingFlex[0]/[1] level (wingroot_left/right). Left/right chains are
// NOT mirror images of each other in ToLiss's own data (see docs/a339_plan.md
// §1.3), so each is transcribed verbatim rather than derived.
mounts a339 {
  wingroot_left { stock: src/lights/mounts/a339/wingroot_left.stock.obj; }
  wingroot_right { stock: src/lights/mounts/a339/wingroot_right.stock.obj; }
  wingtip_left { stock: src/lights/mounts/a339/wingtip_left.stock.obj; }
  wingtip_right { stock: src/lights/mounts/a339/wingtip_right.stock.obj; }
  nosegear { stock: src/lights/mounts/a339/nosegear.stock.obj; }
  nose_turnoff_left { stock: src/lights/mounts/a339/nose_turnoff_left.stock.obj; }
  nose_turnoff_right { stock: src/lights/mounts/a339/nose_turnoff_right.stock.obj; }
  nose_to { stock: src/lights/mounts/a339/nose_to.stock.obj; }
  stab_logo_left { stock: src/lights/mounts/a339/stab_logo_left.stock.obj; }
  stab_logo_right { stock: src/lights/mounts/a339/stab_logo_right.stock.obj; }
  scan_left_fwd { stock: src/lights/mounts/a339/scan_left_fwd.stock.obj; }
  scan_left_aft { stock: src/lights/mounts/a339/scan_left_aft.stock.obj; }
  scan_right_fwd { stock: src/lights/mounts/a339/scan_right_fwd.stock.obj; }
  scan_right_aft { stock: src/lights/mounts/a339/scan_right_aft.stock.obj; }
}

// -- A320: the base airframe --
airframe a320 {
  fixture tail_nav "Tail Nav" {
    category: nav;
    group g1 "Light 1" {
      hide: 1.5 2.5 AirbusFBW/OHPLightSwitches[2];
      pos: -0.07 0.7 31.26;
      nav_tail_bb;
      nav_tail_sp;
    }
    group g2 "Light 2" {
      hide: -0.5 1.5 AirbusFBW/OHPLightSwitches[2];
      pos: 0.07 0.7 31.26;
      nav_tail_bb;
      nav_tail_sp;
    }
  }
  fixture tail_strobe "Tail Strobe" {
    category: strobe;
    pos: 0 0.7 31.32;
    strobe_tail_bb;
    strobe_tail_sp;
  }
  fixture top_beacon "Top Beacon" {
    category: beacon;
    mount: beacon_fus;
    group g1 {
      pos: 0 -0.001 0.008;
      beacon_bb;
    }
    group g2 {
      pos: 0 0 0;
      beacon_pm;
    }
  }
  fixture logo "Logo Lights" {
    category: logo;
    mount: logo_fus;
    logo_bb#left { pos: -3.016 0.304 -2.699;  index: 7; }
    logo_pm#left { pos: -3.008 0.355 -2.7;  index: 7;  dir: 0.589 0.805 -0.074; }
    logo_bb#right { pos: 2.887 0.246 -2.718;  index: 8; }
    logo_pm#right { pos: 2.878 0.298 -2.719;  index: 8;  dir: -0.588 0.805 -0.081; }
  }
  fixture landing_left "Retractable Landing Light #1" {
    category: landing;
    mount: gear_left;
    pos: 0.149 -0.03 -0.06;
    // (+x right, +y up, +z aft)
    offset: 0 0 0;
    @realwings { offset: -0.05 -0.2 -0.2; }  
    @durantula { offset: 0 0 0; }   // TODO: measure the Durantula delta
    landing_bb { index: 0;  dir: -0.053 -0.987 -0.151; }
    landing_main { pos: 0.151 0.002 -0.055;  index: 0;  dir: 0.033 -0.99 -0.134; }
    landing_mid { pos: 0.151 0.002 -0.055;  index: 0;  dir: 0.253 -0.99 -0.134; }
    landing_wide { pos: 0.151 0.002 -0.055;  index: 0;  dir: 0.459 -0.99 -0.134; }
  }
  fixture landing_right "Retractable Landing Light #2" {
    category: landing;
    mount: gear_right;
    pos: -0.133 -0.025 -0.063;
    offset: 0 0 0;
    @realwings { offset: 0.08 -0.18 -0.2; }   // TODO: measure the RealWings delta
    @durantula { offset: 0 0 0; }   // TODO: measure the Durantula delta
    landing_bb { index: 1;  dir: 0.053 -0.987 -0.151; }
    landing_main { pos: -0.135 0.007 -0.059;  index: 1;  dir: -0.033 -0.99 -0.134; }
    landing_mid { pos: -0.135 0.007 -0.059;  index: 1;  dir: -0.253 -0.99 -0.134; }
    landing_wide { pos: -0.135 0.007 -0.059;  index: 1;  dir: -0.459 -0.99 -0.134; }
  }
  fixture landing_spill { raw: src/lights/raw/a320/landing_spill.obj; }
  fixture nose_rwyturnoff "Nosegear - Runway Turn Off" {
    category: rwyturnoff;
    mount: nosegear;
    rwy_bb#a { pos: 0.814 -0.146 0.765;  index: 3;  dir: 0.085 -0.936 0.341; }
    rwy_pm#a { pos: 0.811 -0.097 0.708;  index: 3;  dir: 0.085 -0.64 0.764; }
    rwy_bb#b { pos: 0.814 -0.145 0.15;  index: 4;  dir: 0.085 -0.936 -0.341; }
    rwy_pm#b { pos: 0.811 -0.098 0.209;  index: 4;  dir: 0.085 -0.64 -0.764; }
  }
  fixture nose_to "Nosegear - T.O. Light" {
    category: to;
    mount: nosegear;
    to_bb { pos: 0.34 -0.392 0.71; }
    to_pm { pos: 0.34 -0.387 0.71; }
  }
  fixture nose_taxi "Nosegear - Taxi" {
    category: taxi;
    mount: nosegear;
    taxi_pm { pos: 0.31 -0.387 0.195; }
  }
  fixture wing_strobe "Wing Strobe" {
    category: strobe;
    mirror: true;
    omit: realwings;
    mount: wing_left;  @starboard { mount: wing_right; }
    // RealWings bakes its own wingtip strobes (hence omit: realwings). This
    // offset corrects THEIR misplacement in the mod's OBJ — read by
    // patch_realwings.py and added to the baked position (X mirrored per side).
    // Not emitted into lights_out; stock/durantula are unaffected. RealWings
    // ships CEO and NEO as separate OBJs with different placement: @fence is the
    // CEO wing (reported too high and off on X — TODO: measure in-sim), the
    // @realwings base is NEO/sharklet, which is correct as baked (leave 0).
    offset: 0 0 0;                          // stock/durantula: no shift
    @realwings {
      offset: 0 0 0;                        // NEO / sharklet OBJ: correct as baked
      // CEO OBJ: RealWings bakes nav & strobe in each other's spots. This offset
      // moves the strobe onto the (old) nav spot; wing_nav's @fence does the
      // reverse — together they swap the two. = (nav_baked - strobe_baked) + the
      // fine-tune that had been on wing_nav.  X: Y: Up (+) / Down (-) Z:
      @fence { offset: -0.078 -0.041 0.138; }
    }
    group fence {
      hide: 1 1 anim/SHARK;
      pos: -0.29 0.031 -1.008;
      strobe_marker#a { dir: -0.354 0.866 -0.354; }
      strobe_marker#b { dir: -0.354 -0.866 -0.354; }
      strobe_beam { dir: -0.707 0 -0.707; }
      strobe_spill { pos: -0.286 0.03 -1.006;  dir: -0.895 -0.094 -0.436; }
    }
    group sharklet {
      hide: 0 0 anim/SHARK;
      pos: -0.909 0.452 -0.346;
      strobe_marker#a { dir: 0.866 0 -0.5;  cone: 0.1; }
      strobe_marker#b { dir: -0.863 -0.087 -0.498;  cone: 0.1; }
      strobe_beam { index: 0;  @starboard { index: 1; }  dir: -0.863 -0.087 -0.498;  cone: 0.5; }
      strobe_spill { pos: -0.896 0.452 -0.317;  dir: -0.992 -0.086 0.088; }
    }
  }
  fixture wing_nav "Wing Nav" {
    category: nav;
    mirror: true;
    omit: realwings;
    mount: wing_left;  @starboard { mount: wing_right; }
    // Corrects RealWings' baked wingtip nav placement — see wing_strobe above.
    // @fence = CEO (TODO measure); @realwings base = NEO/sharklet (correct, 0).
    // Read by patch_realwings.py, not emitted here.
    offset: 0 0 0;                          // stock/durantula: no shift
    @realwings {
      offset: 0 0 0;                        // NEO / sharklet OBJ: correct as baked
      // CEO OBJ: RealWings bakes nav & strobe in each other's spots. This offset
      // moves the nav onto the (old) strobe spot; wing_strobe's @fence does the
      // reverse — together they swap the two. = (strobe_baked - nav_baked) + the
      // fine-tune that had been on wing_strobe.  X: Y: Up (+) / Down (-) Z:
      @fence { offset: 0.028 -0.024 -0.038; }
    }
    group fence {
      hide: 1 1 anim/SHARK;
      pos: -0.194 0.021 -1.205;
      nav_marker#up { dir: -0.354 0.866 -0.354; }
      nav_marker#down { dir: -0.354 -0.866 -0.354; }
      nav_beam { dir: -0.574 0 -0.819; }
      nav_spill { pos: -0.175 0.021 -1.181;  dir: -0.865 -0.16 -0.476; }
    }
    group sharklet {
      hide: 0 0 anim/SHARK;
      pos: -0.103 0.004 -1.314;
      nav_marker#up {
        dir: -0.354 0.866 -0.354;
        cone: 0.01;
        intensity: 50;
        @led { intensity: 80;  @starboard { intensity: 50; } }
      }
      nav_marker#down {
        dir: -0.354 -0.866 -0.354;
        cone: 0.01;
        intensity: 50;
        @led { intensity: 80;  @starboard { intensity: 50; } }
      }
      nav_beam { dir: -0.707 0 -0.707; }
      nav_spill { dir: -0.865 -0.16 -0.476; }
    }
  }
  fixture wing "Wing Lights" {
    category: wing;
    wing_bb#left { pos: -1.943 -0.08 2.52;  index: 1;  dir: -0.939 -0.035 0.342; }
    wing_pm#left { pos: -1.984 -0.08 2.52;  index: 1;  dir: -0.574 0 0.819; }
    wing_bb#right { pos: 1.941 -0.08 2.52;  index: 2;  dir: 0.939 -0.035 0.342; }
    wing_pm#right { pos: 2.018 -0.08 2.52;  index: 2;  dir: 0.574 0 0.819;  intensity: 40000; }
  }
  fixture bottom_beacon "Bottom Beacon" {
    category: beacon;
    group g1 {
      pos: 0 -2.404 7.956;
      beacon_bb { index: 1;  intensity: 12000;  @led { intensity: 24000; } }
    }
    group g2 {
      pos: 0 -2.403 7.948;
      beacon_pm { index: 1;  intensity: 4000;  @led { intensity: 6000; } }
    }
  }

  // ==========================================================================
  // INTERIOR (cockpit) — target: interior -> objects/lights_inn.obj
  // ==========================================================================
  // Gus's mod, folded into one runtime-switchable OBJ. 23 lights in 4
  // categories; full table in docs/interior_plan.md §1.2.
  //
  // These live in the a320 block ON PURPOSE: a319/a321 `extends a320` and so
  // inherit them byte-identically, which is correct — Gus's A320 and A321
  // variants are byte-identical and stock lights_inn.obj is the same file on
  // all three. a339 does NOT extend a320, so it inherits nothing and is kept
  // out of the interior mod for free (decision #14).
  //
  // No `mirror: true` anywhere: a mirrored fixture would emit two full
  // category-gated blocks where one does, so the pairs are written out
  // explicitly. (It also lines the file up with Gus's, which is convenient but
  // not the reason — see docs/interior_plan.md §0.1.)

  fixture int_dome_lights "Dome Lights" {
    target: interior;
    category: dome;
    int_dome#left  { pos: -0.472 1.09 -3.35; }
    int_dome#right { pos:  0.472 1.09 -3.35; }
  }

  // The flood and the two table lamps all share panel[3], the PEDESTAL knob.
  // The two `int_tablet` lamps used to live here too and have moved to
  // int_map_lamps below — they are the map lights, not pedestal lights.
  fixture int_pedestal "Pedestal & Tables" {
    target: interior;
    category: pedestal;
    int_flood         { pos:  0     0.8    -4.1; }
    // Gus calls these the CA/FO "table" lights, but aimed down and aft from
    // y 0.333 what they actually wash is each pilot's footwell and seat. Both
    // keep his cone (the type default, 0.701 = 45.5°): a 2026-07-28 attempt to
    // narrow the captain's was aimed at the wrong light and has been reverted.
    int_table#ca      { pos: -0.5577 0.3333 -4.5; }
    int_table#fo      { pos:  0.5577 0.3333 -4.5; }
  }

  // The two overhead MAP / reading lamps, one per pilot — the pair Gus names
  // "tablet". Aimed down, forward and outboard from y 0.7 onto each pilot's tray
  // table and side console: the lights you read a chart by.
  //
  // ⚠ THE ONE PLACE `map` IS NOT A SINGLE BRIGHTNESS SOURCE. These run off
  // panel[3] (the PEDESTAL rheostat), which is how ToLiss wires them, while
  // int_spot3 below runs off `ckpt/lights/map`. Grouped by FIXTURE ROLE instead,
  // because by rheostat the Map row held only that spot — invisible whenever the
  // map knob is down, so the row looked dead — and the Pedestal row silently
  // recolored the reading lamps. Accepted cost: the pedestal knob dims a light
  // the Map row recolors. This is not licence to merge `mainpnl` into `map`.
  fixture int_map_lamps "Map Lights" {
    target: interior;
    category: map;
    // dir normalised 2026-07-29 (was -/+0.35 -0.75 -0.4, |d| 0.919). Same aim;
    // `cone` is compared against a dot product with it, so length is not free.
    int_tablet#ca     { pos: -0.8    0.7    -4.0;  dir: -0.381 -0.816 -0.435; }
    int_tablet#fo     { pos:  0.8    0.7    -4.0;  dir:  0.381 -0.816 -0.435; }
  }

  fixture int_console "Console Lights" {
    target: interior;
    category: console;
    int_console#l1 { pos: -1.1471  0.0333 -4.2;   index: 22; }
    int_console#l2 { pos: -1.3463  0.0032 -3.65;  index: 22; }
    int_console#l3 { pos: -1.4369 -0.0101 -3.3;   index: 22; }
    int_console#r1 { pos:  1.1471  0.0333 -4.2;   index: 23; }
    int_console#r2 { pos:  1.3463  0.0032 -3.65;  index: 23; }
    int_console#r3 { pos:  1.4369 -0.0101 -3.3;   index: 23; }
  }

  // The four panel flood lamps — the FLOOD LT MAIN PNL knob, category
  // `mainpnl`. One fixture per lamp because the mount (the ckpt/lights/<n>
  // transform stack) is a per-fixture property. The rheostat index is
  // per-LIGHT and is NOT uniform per lamp — lamp 3 straddles panel[1] and
  // panel[2]. Transcribed as-is.
  //
  // NOT the map lights — that is the ckpt/lights/map spot below. Confirmed
  // in-sim 2026-07-28: turning the `map` category changed the MAIN PNL flood.
  //
  // Called `int_map1`..`4` / `int_maplamp` / mount `maplamp<n>` until
  // 2026-07-28. That name was this project's own, not Gus's — his files never
  // use "map" at all — and it contradicted the category, the dataref and the
  // menu label, misidentifying these lamps twice (interior_plan.md §1.3c,
  // §2.2b). Identify a light by its rheostat, never by its name.
  //
  // ⚠ OPEN — the geometry does not match "four floods spread across the main
  // panel". All four mounts bake the SAME rest position (-0.1898, 0.2453,
  // -4.6109), so they are coincident rather than spread in x, and differ in
  // DIRECTION instead (1/4 shallow down-forward, 2/3 steeply down-aft). The
  // only x spread is ToLiss's ckpt/lights/<n>/x/dir, keyframed 0 -> 0.1 (10 cm).
  // y 0.245 is below the table lamps (0.333) and the pedestal flood (0.8):
  // footwell height, not glareshield height. Four fixtures in a 10 cm box, each
  // with adjustable x/y/z, fits four STOWED MOVABLE lamps just as well, so the
  // `mainpnl` assignment rests on that one in-sim observation. Probably also
  // what parked the debug-tool axis hunt — "the outer floods are wrong under
  // all 48 permutations" is what you would see with no outer floods at rest.
  // See docs/dev-tools.md.
  //
  // Cone values are Gus's measured ones, rounded to the project-wide 3 dp by the
  // emitter. That also settles the §1.2 note about lamp 4's 0.9063077 vs lamp
  // 1's 0.906307: both round to 0.906. Decided, not drifted.
  //
  // >>> DIRECTIONS NORMALISED 2026-07-29, and this is a lead on the open thread
  //     above. X-Plane compares `cone` against a DOT PRODUCT with `dir`, so an
  //     effective threshold of cone/|dir| applies. Gus's vectors here were:
  //
  //       lamps 1 & 4 (the OUTER pair)   |d| 0.180 and 0.258
  //       lamps 2 & 3 (the MIDDLE pair)  |d| 1.552
  //
  //     At |d| 0.18 with cone 0.819 the effective threshold is 4.55 — far past
  //     1, i.e. no direction can satisfy it, so the lamp cannot behave as a cone
  //     at all and `cone` has nothing left to change. That is precisely the pair
  //     reported in-sim as "the OUTER floods are wrong under every one of the 48
  //     permutations", and precisely the lamp reported as "cone edits have no
  //     visible effect". The middle pair at |d| 1.55 were merely too WIDE
  //     (threshold 0.584 ≈ 54° where 0.906 ≈ 25° was authored) — and those are
  //     the two the cycler said looked right.
  //
  //     Aim is unchanged by this; only length is. If the outer floods now behave,
  //     the axis-permutation hunt was chasing the wrong cause and can be closed.
  //     The old values are on each line.
  fixture int_panelflood1 "Panel Flood Lamp 1" {
    target: interior;
    category: mainpnl;
    mount: panelflood1;
    pos: 0 0 0;   // real placement comes from the mount's ckpt/lights/1 animation
    int_panelflood#a { index: 1;  dir: 0 -0.832 -0.555;  cone: 0.819152; }   // was 0 -0.15 -0.1 (|d| 0.180)
    int_panelflood#b { index: 1;  dir: 0 -0.814 -0.581;  cone: 0.906307; }   // was 0 -0.21 -0.15 (|d| 0.258)
  }
  fixture int_panelflood2 "Panel Flood Lamp 2" {
    target: interior;
    category: mainpnl;
    mount: panelflood2;
    pos: 0 0 0;
    int_panelflood#a { index: 1;  dir: 0 -0.966 0.258;  cone: 0.906307; }
    int_panelflood#b { index: 1;  dir: 0 -0.966 0.258;  cone: 0.866025; }
    int_panelflood#c { index: 1;  dir: 0 -0.966 0.258;  cone: 0.642787; }
  }
  fixture int_panelflood3 "Panel Flood Lamp 3" {
    target: interior;
    category: mainpnl;
    mount: panelflood3;
    pos: 0 0 0;
    // index 2, NOT Gus's 1 — see the §1.3e note above the fixture block.
    int_panelflood#a { index: 2;  dir: 0 -0.966 0.258;  cone: 0.906307; }
    int_panelflood#b { index: 2;  dir: 0 -0.966 0.258;  cone: 0.866025; }
    int_panelflood#c { index: 2;  dir: 0 -0.966 0.258;  cone: 0.642787; }
  }
  fixture int_panelflood4 "Panel Flood Lamp 4" {
    target: interior;
    category: mainpnl;
    mount: panelflood4;
    pos: 0 0 0;
    int_panelflood#a { index: 2;  dir: 0 -0.832 -0.555;  cone: 0.819152; }   // was 0 -0.15 -0.1 (|d| 0.180)
    int_panelflood#b { index: 2;  dir: 0 -0.814 -0.581;  cone: 0.9063077; }  // was 0 -0.21 -0.15 (|d| 0.258)
  }

  // -- The three re-added .acf cockpit spots (docs/interior_plan.md §3.4) ----
  //
  // The installer disables ToLiss's three sim 3D spots (_spot_name_3d/* = none)
  // and they reappear here as OBJ lights, so their color follows the runtime
  // switch instead of being frozen at install time by a Plane Maker edit.
  //
  // POSITIONS ARE DERIVED, NOT GUESSED. The .acf states spot positions in FEET
  // against a per-airframe datum; the interior OBJ is attached at
  // _obja/11/_v10_att_{x,y,z}_acf_prt_ref = (0, 0.4, 26.00 / 20.75 / 6.78 ft)
  // for a319 / a320 / a321. So:
  //
  //     obj_metres = (acf_feet - attach_feet) * 0.3048
  //
  // That difference is the SAME on all three airframes (spot 1 lands at
  // z = -3.429 / -3.432 / -3.432 m — a 3 mm spread from rounding in the .acf),
  // which is what keeps one shared lights_inn.obj correct for all of them.
  //
  // Cross-check: spot 1 is the panel_brightness_ratio[0] rheostat — the DOME
  // light — and the conversion puts it at y 1.097, z -3.432, against Gus's own
  // dome lights at y 1.09, z -3.35. Two independent axes agree to within 8 cm,
  // so the conversion is sound.
  //
  // ⚠ DIRECTION IS THE OPEN QUESTION — the main Phase VI tuning target.
  // Gus sets _spot_the/0 = -60 (pitch) and _spot_psi/0 = 180 (heading). Taking
  // psi=0 as "toward the nose" (OBJ -Z), psi=180 pitch=-60 gives
  // dir = (0, -0.866, 0.5): down and AFT. But the panels these lights wash are
  // FORWARD of the fixture (pedestal z -4.1, consoles -3.3..-4.2, panel floods
  // -4.61), so aft points away from them. Either Plane Maker measures spot
  // heading from the tail, or Gus's 180 means "forward" in that UI.
  //   >>> If the cockpit looks lit from behind in-sim, flip dz: 0.5 -> -0.5.
  // Both readings are one edit apart, which is exactly why this lives here and
  // not in Python. Spots 2 and 3 keep their stock headings (psi -20 / 14, near
  // enough to straight down at pitch -66 / -53 that the ambiguity barely bites).
  //
  // CONE and SIZE are seeds too: cone is cos(_spot_angle) which is at least
  // dimensionally right, but the .acf `_spot_size` (8/9/10) is in sim-spot
  // units that do NOT map onto the OBJ size slot, so those are eyeballed
  // against Gus's own values (dome 1.414, pedestal flood 2.0).
  fixture int_spot_dome "Cockpit Spot 1 (dome)" {
    target: interior;
    category: dome;
    int_spot1 { pos: 0 1.097 -3.432;  dir: 0 -0.866 0.5; }
  }
  fixture int_spot_pedestal "Cockpit Spot 2 (pedestal)" {
    target: interior;
    category: pedestal;
    // stock _spot_the/1 = -66, _spot_psi/1 = 0 -> down, very slightly forward
    int_spot2 { pos: 0 1.036 -3.52;  dir: 0 -0.914 -0.407; }
  }
  // The ckpt/lights/map spot. Category `map`, alongside the two reading lamps in
  // int_map_lamps above — not `mainpnl`, whose lamps come from panel[1]/[2].
  //
  // The only light on the MAP rheostat, so with that knob down the plugin drives
  // its alpha to 0 and it alone disappears. Turn the map light up before judging
  // any change to THIS light.
  fixture int_spot_map "Cockpit Spot 3 (map light)" {
    target: interior;
    category: map;
    // stock _spot_the/2 = -53, _spot_psi/2 = 14 -> down, forward, slightly right
    int_spot3 { pos: 0.244 1.097 -3.463;  dir: 0.146 -0.799 -0.584; }
  }

  // ==========================================================================
  // SCREENS (display glow) — target: screens -> objects/lights_screens.obj
  // ==========================================================================
  // EXPERIMENTAL (docs/screens_plan.md). Six spill lights, one per main display
  // unit, throwing each screen's own wash back into the cockpit.
  //
  // Like the interior these sit in the a320 block so a319/a321 inherit them, and
  // a339 (which does not `extends a320`) gets nothing — its cockpit is a
  // different model and these coordinates would be wrong for it.
  //
  // SAME COORDINATE FRAME AS lights_inn.obj. patch_acf_screens.py copies the
  // attachment point from the aircraft's OWN lights_inn.obj row rather than
  // hardcoding one, so these coordinates mean the same thing on all three
  // airframes — exactly as the interior's do, and for the same reason.
  //
  // POSITIONS were seeded from the panel geometry around the screens (ToLiss
  // draws the DUs from its own plugin rather than as ATTR_cockpit faces, so there
  // is no screen geometry in the OBJs to measure) and then TUNED IN-SIM
  // 2026-07-29 with the live light debug tool. The measured seed basis, kept
  // because it is the only independent check on these numbers:
  //
  //     glareshield front bar   y  0.379   z -4.408   (1.20 m wide)
  //     main instrument panel   y  0.139   z -4.591   (2.19 m wide)
  //     flat panel strip        y  0.093   z -4.604   (1.44 m wide)
  //
  // Five of the six landed on one plane — y 0.08, z -4.67 — with x mirrored about
  // the centreline, which is what a row of panel-mounted DUs should look like.
  // Re-tune with:
  //
  //     python build/build_objs.py build --target screens --debug --write
  //
  // and use the position MARKERS (Marker: This/All in the dev window) rather than
  // judging by the pool of light — the glow's centre is not its origin.
  //
  // ⚠ TWO NUMBERS PER FIXTURE MUST AGREE WITH THE PLUGIN, and they are different
  // numbers:
  //   `spill_dref: .../spill/<n>` — the light's own slot, n = fixture order.
  //   `index: <du>`               — which AirbusFBW/DUBrightness element drives
  //                                 it, and it is NOT the same as n.
  // `index` must equal kScreenDU[n] in src/native/src/plugin.cpp; a test compares
  // them. The DU order was settled in-sim 2026-07-29 by dimming one display at a
  // time, and it is NOT left-to-right — it is the Airbus DU numbering:
  //
  //     DUBrightness[0] CA PFD   [1] CA ND   [2] FO PFD
  //     DUBrightness[3] FO ND    [4] E/WD    [5] SD
  //
  // `profile: screen;` not `category:` — one look, no gate. See lights.style.phdsl.

  fixture screen_capt_pfd "Captain PFD Glow" {
    target: screens;
    profile: screen;
    screen_glow { pos: -0.59 0.12 -4.67;  index: 0;  spill_dref: ToLissPhoton/screens/spill/0; }
  }
  fixture screen_capt_nd "Captain ND Glow" {
    target: screens;
    profile: screen;
    screen_glow { pos: -0.37 0.12 -4.67;  index: 1;  spill_dref: ToLissPhoton/screens/spill/1; }
  }
  // The ECAM pair are stacked on the centreline, upper (E/WD) above lower (SD).
  // Their x is 0.012 rather than 0 because that is where they tuned to — the
  // stack is very slightly off the aircraft centreline.
  fixture screen_ecam_upper "Upper ECAM Glow" {
    target: screens;
    profile: screen;
    screen_glow { pos: 0.012 0.12 -4.67;  index: 4;  spill_dref: ToLissPhoton/screens/spill/2; }
  }
  // ⚠ The odd one out: every other light tuned onto the y 0.08 / z -4.67 plane,
  // and this one sits 2 cm ABOVE and 8 cm AFT of them — i.e. above the upper
  // ECAM's glow, which is not where an SD is. Taken from the tool's absolute
  // readout as reported (2026-07-29) and confirmed as intended. If the lower
  // ECAM ever looks like it is lighting from the wrong place, this is the line.
  fixture screen_ecam_lower "Lower ECAM Glow" {
    target: screens;
    profile: screen;
    screen_glow { pos: 0.012 -0.07 -4.62;  index: 5;  spill_dref: ToLissPhoton/screens/spill/3; }
  }
  fixture screen_fo_nd "First Officer ND Glow" {
    target: screens;
    profile: screen;
    screen_glow { pos: 0.37 0.12 -4.67;  index: 3;  spill_dref: ToLissPhoton/screens/spill/4; }
  }
  fixture screen_fo_pfd "First Officer PFD Glow" {
    target: screens;
    profile: screen;
    screen_glow { pos: 0.59 0.12 -4.67;  index: 2;  spill_dref: ToLissPhoton/screens/spill/5; }
  }
}

// -- A319: position deltas vs a320 --
airframe a319 extends a320 {
  tail_nav {
    g1 nav_tail_bb { pos: -0.042 0.706 29.14; }
    g1 nav_tail_sp { pos: -0.029 0.706 29.14; }
    g2 nav_tail_bb { pos: -0.042 0.706 29.14; }
    g2 nav_tail_sp { pos: -0.029 0.706 29.14; }
  }
  tail_strobe {
    strobe_tail_bb { pos: 0.034 0.702 29.14; }
    strobe_tail_sp { pos: 0.034 0.705 29.14; }
  }
  top_beacon {
    mount: none;
    g1 beacon_bb { pos: 0 1.983 7.928; }
    g2 beacon_pm { pos: 0 1.984 7.928; }
  }
  logo {
    mount: none;
    logo_bb#left { pos: -2.982 1.009 26.41; }
    logo_pm#left { pos: -2.973 1.061 26.41; }
    logo_bb#right { pos: 2.921 0.951 26.41; }
    logo_pm#right { pos: 2.913 1.003 26.41; }
  }
  wing_nav {
    sharklet nav_spill { pos: -0.098 -0.003 -1.302; }
  }
  wing {
    wing_bb#left { pos: -1.943 -0.088 2.458; }
    wing_pm#left { pos: -1.984 -0.086 2.501; }
    wing_bb#right { pos: 1.941 -0.088 2.459; }
    wing_pm#right { pos: 2.018 -0.086 2.501; }
  }
  landing_spill {
    raw: src/lights/raw/a319/landing_spill.obj;
  }
}

// -- A321: position deltas vs a320 --
airframe a321 extends a320 {
  tail_nav {
    mount: tail_fus;
    g1 nav_tail_bb { pos: -0.076 0.001 0.031; }
    g1 nav_tail_sp { pos: -0.063 0.001 0.003; }
    g2 nav_tail_bb { pos: -0.076 0.001 0.031; }
    g2 nav_tail_sp { pos: -0.063 0.001 0.003; }
  }
  tail_strobe {
    mount: tail_fus;
    strobe_tail_bb { pos: 0 -0.003 0.031; }
    strobe_tail_sp { pos: 0 0 0; }
  }
  nose_taxi {
    taxi_pm { pos: 0.31 -0.392 0.195; }
  }
  wing_nav {
    sharklet nav_spill { pos: -0.098 -0.003 -1.302; }
  }
  wing {
    wing_bb#left { pos: -1.943 -0.028 1.428; }
    wing_pm#left { pos: -1.984 -0.026 1.461; }
    wing_bb#right { pos: 1.941 -0.028 1.419; }
    wing_pm#right { pos: 2.018 -0.026 1.471; }
  }
}

// -- A330-900: standalone, NOT extends a320 --
// Structurally different from the A3xx: WingFlex[0..9] rotate chains (not
// fence/sharklet), no wing mods (no @realwings/omit), wing-mounted landing
// lights (no LandingLightLocation gate), logo lights on the PitchTrim chain,
// dual NAV1/NAV2 bulb positions at the wingtips too. Left/right wingtip
// nav/strobe positions are transcribed verbatim from ToLiss's own data rather
// than mirrored (they're not exact mirrors — see docs/a339_plan.md §1.3), so
// those four fixtures are deliberately separate, non-mirrored pairs; the
// nav/strobe color (red/green) and side-conditioned intensity that a
// mirrored fixture would resolve automatically are instead given as explicit
// unconditioned overrides on the starboard fixture's light references.
airframe a339 {
  fixture landing_left "Landing Light Left" {
    category: landing;
    mount: wingroot_left;
    pos: -0.357 0.674 -2.212;
    landing_bb { index: 0;  dir: 0 -0.05 -0.999; }
    landing_main { index: 0;  dir: 0 -0.05 -0.999; }
    landing_mid { index: 0;  dir: 0 -0.05 -0.999; }
    landing_wide { index: 0;  dir: 0 -0.05 -0.999; }
  }
  fixture landing_right "Landing Light Right" {
    category: landing;
    mount: wingroot_right;
    pos: 0.357 0.674 -2.212;
    landing_bb { index: 1;  dir: 0 -0.05 -0.999; }
    landing_main { index: 1;  dir: 0 -0.05 -0.999; }
    landing_mid { index: 1;  dir: 0 -0.05 -0.999; }
    landing_wide { index: 1;  dir: 0 -0.05 -0.999; }
  }
  fixture wingtip_nav_left "Wingtip Nav Left" {
    category: nav;
    mount: wingtip_left;
    group g1 "Nav 1" {
      hide: 1.5 2.5 AirbusFBW/OHPLightSwitches[2];
      pos: -1.451 0.252 0.336;
      nav_marker { dir: -0.819 0 -0.573; }
      // Bright wingtip billboard — the A320 wingtip fence has this; ToLiss's
      // stock A339 wingtip did not, hence the dim nav. Seeded from A320's
      // `light nav_beam` (intensity 5000 / LED 6000, cone 0.2). Tune to taste.
      nav_beam { dir: -0.819 0 -0.573; }
      nav_spill { dir: -0.819 0 -0.573; }
    }
    group g2 "Nav 2" {
      hide: -0.5 1.5 AirbusFBW/OHPLightSwitches[2];
      pos: -1.486 0.248 0.371;
      nav_marker { dir: -0.819 0 -0.573; }
      nav_beam { dir: -0.819 0 -0.573; }
      nav_spill { dir: -0.819 0 -0.573; }
    }
  }
  fixture wingtip_nav_right "Wingtip Nav Right" {
    category: nav;
    mount: wingtip_right;
    // nav_marker/nav_spill extend nav_base, which resolves red/green (and
    // nav_spill's LED intensity) via @starboard — meaningless on a
    // non-mirrored fixture (side is never set), so the starboard-equivalent
    // values are given here explicitly instead.
    group g1 "Nav 1" {
      hide: 1.5 2.5 AirbusFBW/OHPLightSwitches[2];
      pos: 1.457 0.253 0.322;
      nav_marker { color: green;  dir: 0.819 0 -0.573; }
      // Explicit green + starboard intensity: @starboard doesn't resolve on a
      // non-mirrored fixture, so the A320's per-side nav_beam values (starboard
      // 4000 / LED 5000) are given here directly. Tune to taste.
      nav_beam { color: green;  intensity: 4000;  @led { intensity: 5000; }  dir: 0.819 0 -0.573; }
      nav_spill { color: green;  intensity: 1000;  @led { intensity: 3000; }  dir: 0.819 0 -0.573; }
    }
    group g2 "Nav 2" {
      hide: -0.5 1.5 AirbusFBW/OHPLightSwitches[2];
      pos: 1.488 0.248 0.367;
      nav_marker { color: green;  dir: 0.819 0 -0.573; }
      nav_beam { color: green;  intensity: 4000;  @led { intensity: 5000; }  dir: 0.819 0 -0.573; }
      nav_spill { color: green;  intensity: 1000;  @led { intensity: 3000; }  dir: 0.819 0 -0.573; }
    }
  }
  fixture wingtip_strobe_left "Wingtip Strobe Left" {
    category: strobe;
    mount: wingtip_left;
    pos: -1.564 0.26 0.515;
    strobe_marker { index: 0;  dir: -0.707 0 -0.707; }
    // Bright wingtip strobe billboard the A320 has and stock A339 lacked.
    // Seeded from A320's `light strobe_beam` (intensity 30000, cone 0.01 — a
    // tight, punchy flash). Widen cone here if it reads too pinpoint. Tune to taste.
    strobe_beam { index: 0;  dir: -0.707 0 -0.707; }
    strobe_spill { index: 0;  dir: -0.707 0 -0.707; }
  }
  fixture wingtip_strobe_right "Wingtip Strobe Right" {
    category: strobe;
    mount: wingtip_right;
    pos: 1.574 0.261 0.509;
    strobe_marker { index: 1;  dir: 0.707 0 -0.707; }
    strobe_beam { index: 1;  dir: 0.707 0 -0.707; }
    strobe_spill { index: 1;  dir: 0.707 0 -0.707; }
  }
  fixture tail_nav "Tail Nav" {
    category: nav;
    group g1 "Light 1" {
      hide: 1.5 2.5 AirbusFBW/OHPLightSwitches[2];
      pos: -0.06 1.78 32.03;
      nav_tail_bb;
      nav_tail_sp { dir: 0 0 1; }
    }
    group g2 "Light 2" {
      hide: -0.5 1.5 AirbusFBW/OHPLightSwitches[2];
      pos: 0.06 1.78 32.03;
      nav_tail_bb;
      nav_tail_sp { dir: 0 0 1; }
    }
  }
  fixture tail_strobe "Tail Strobe" {
    category: strobe;
    pos: 0 1.78 32.03;
    strobe_tail_bb { dir: 0 0 1; }
    strobe_tail_sp { dir: 0 0 1; }
  }
  fixture top_beacon "Top Beacon" {
    category: beacon;
    pos: 0 2.85 -4.35;
    beacon_bb;
    beacon_pm;
  }
  fixture bottom_beacon "Bottom Beacon" {
    category: beacon;
    pos: 0 -3.13 -9.3;
    beacon_bb;
    beacon_pm;
  }
  fixture nose_taxi "Nosegear - Taxi" {
    category: taxi;
    mount: nosegear;
    pos: -0.358 -0.46 -0.242;
    taxi_pm { dir: 0 -0.05 -0.999; }
    taxi_bb { dir: 0 -0.05 -0.999; }
  }
  fixture nose_to "Nosegear - T.O. Light" {
    category: to;
    mount: nose_to;
    pos: 0.358 -0.46 -0.242;
    to_bb { dir: 0 -0.05 -0.999; }
    to_pm { dir: 0 -0.05 -0.999; }
  }
  fixture rwyturnoff_left "Runway Turn Off Left" {
    category: rwyturnoff;
    mount: nose_turnoff_left;
    pos: 0 0 0.03;
    rwy_bb { index: 3;  dir: 0 -0.05 -0.999; }
    rwy_pm { index: 3;  dir: 0 -0.05 -0.999; }
  }
  fixture rwyturnoff_right "Runway Turn Off Right" {
    category: rwyturnoff;
    mount: nose_turnoff_right;
    pos: 0 0 0.03;
    rwy_bb { index: 4;  dir: 0 -0.05 -0.999; }
    rwy_pm { index: 4;  dir: 0 -0.05 -0.999; }
  }
  fixture logo_left "Logo Light Left" {
    category: logo;
    mount: stab_logo_left;
    pos: 0.02 -0.04 0.01;
    // Local dirs computed (build helper) so the mount's static -80° rotation
    // reproduces the A320 logo world aim: bb straight up (0 1 0), pm up-inboard
    // (0.589 0.805 -0.074). Verify in-sim and tweak.
    logo_bb { index: 7;  dir: -0.408 0.651 -0.640; }
    logo_pm { index: 7;  dir: -0.076 0.236 -0.969; }
  }
  fixture logo_right "Logo Light Right" {
    category: logo;
    mount: stab_logo_right;
    pos: -0.02 -0.04 0.01;
    // Mirror of logo_left: dirs computed so the mount reproduces the A320 aim
    // (bb up, pm up-inboard -0.588 0.805 -0.081). Verify in-sim and tweak.
    logo_bb { index: 8;  dir: 0.408 0.651 -0.640; }
    logo_pm { index: 8;  dir: 0.082 0.232 -0.969; }
  }
  fixture wing_scan_left_fwd "Wing Scan Left Forward" {
    category: wing;
    mount: scan_left_fwd;
    wing_scan_bb#lower { pos: 0 -0.01 0.01;  index: 1; }
    wing_scan_pm#lower { pos: 0 -0.01 0.01;  index: 1; }
    wing_scan_bb#upper { pos: 0 0.05 0.01;  index: 1; }
    wing_scan_pm#upper { pos: 0 0.05 0.01;  index: 1; }
  }
  fixture wing_scan_left_aft "Wing Scan Left Aft" {
    category: wing;
    mount: scan_left_aft;
    wing_scan_bb#lower { pos: 0 -0.01 0.01;  index: 1; }
    wing_scan_pm#lower { pos: 0 -0.01 0.01;  index: 1; }
    wing_scan_bb#upper { pos: 0 0.05 0.01;  index: 1; }
    wing_scan_pm#upper { pos: 0 0.05 0.01;  index: 1; }
  }
  fixture wing_scan_right_fwd "Wing Scan Right Forward" {
    category: wing;
    mount: scan_right_fwd;
    wing_scan_bb#lower { pos: 0 -0.01 0.01;  index: 2; }
    wing_scan_pm#lower { pos: 0 -0.01 0.01;  index: 2; }
    wing_scan_bb#upper { pos: 0 0.05 0.01;  index: 2; }
    wing_scan_pm#upper { pos: 0 0.05 0.01;  index: 2; }
  }
  fixture wing_scan_right_aft "Wing Scan Right Aft" {
    category: wing;
    mount: scan_right_aft;
    wing_scan_bb#lower { pos: 0 -0.01 0.01;  index: 2; }
    wing_scan_pm#lower { pos: 0 -0.01 0.01;  index: 2; }
    wing_scan_bb#upper { pos: 0 0.05 0.01;  index: 2; }
    wing_scan_pm#upper { pos: 0 0.05 0.01;  index: 2; }
  }
}
