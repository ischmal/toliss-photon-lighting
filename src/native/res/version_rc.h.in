// The version, in the two shapes VERSIONINFO needs. GENERATED by CMake from
// `src/core/version.h` into the build tree — never edit the output, and never
// commit it.
//
// ⚠ TWO SHAPES, NOT ONE, WHICH IS THE WHOLE REASON THIS FILE EXISTS.
// `FILEVERSION` is four 16-bit numbers separated by commas and `FileVersion` is
// a display string; `kPhotonVersion` is neither, and rc.exe cannot turn one into
// the other (it preprocesses, it does not compute). CMake derives both at
// configure time so the version still has exactly one definition.
//
// ⚠ DO NOT "SIMPLIFY" THIS BY INCLUDING core/version.h FROM THE .rc. rc.exe runs
// the C preprocessor over the file and then parses what falls out as resource
// script — `namespace photon { constexpr char ... }` is a syntax error there
// unless the header wraps its body in `#ifndef RC_INVOKED`, and even then only
// the string comes across.
#pragma once

#define PHOTON_RC_FILEVERSION    @PHOTON_VERSION_COMMAS@
#define PHOTON_RC_VERSION_STRING "@PHOTON_VERSION@"
