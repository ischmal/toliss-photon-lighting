// Design tokens — every color, size and metric the installer's UI uses.
//
// ⚠ ONE FILE, AND NOTHING ELSE MAY NAME A LITERAL COLOR. The mockup is still being
// drawn and the palette is expected to move (see docs/installer_gui_plan.md §6 —
// the accent blue does not match the plugin's and that is unresolved), so a hex
// code written into a widget is a retune that gets missed.
//
// The values are taken from the Figma file's returned design context, not
// eyedropped from a screenshot: `G2EQDGYDXvXnKfedLJw0ma`, node `212:1641`.
//
// ⚠ THE FIGMA FILE DEFINES NO VARIABLES (`get_variable_defs` returns `{}`), so
// this file is hand-written. The shape deliberately matches what Figma's official
// "Figma to Slint" plugin emits — one global of `out property`s — so that if the
// palette is ever promoted to Figma Variables, the generated file drops in here
// and every call site keeps working.

export global Tokens {
    // ─── surfaces ────────────────────────────────────────────────────────────
    out property <color> screen-bg: #495057;      // the content area
    out property <color> sidebar-bg: #3d4348;     // the step rail
    out property <color> bar-bg: #2b333a;         // the bottom controls
    out property <color> bar-edge: #0d151c;       // its 1 px top rule
    out property <color> sidebar-edge: #2b333a;   // the rail's 1 px right rule

    out property <color> panel-bg: #3d4348;       // the aircraft list well
    out property <color> panel-border: #2d353b;

    out property <color> card-bg: #495057;
    out property <color> card-border: #2b333a;

    out property <color> field-bg: #e4e8ed;       // text input
    out property <color> field-text: #2b333a;

    // ─── accents and text ────────────────────────────────────────────────────
    // ⚠ `accent` is #509ac8, which is NOT the plugin's kUiBlue (#1678b5). The two
    // products currently read as different ones. Deferred deliberately — see the
    // plan's open threads; do not "fix" it here without deciding it.
    out property <color> accent: #509ac8;
    out property <color> neutral: #7e92a5;        // the secondary button fill
    out property <color> muted: #9eacb9;          // secondary text, inactive marks
    out property <color> text: #ffffff;

    // ─── install status ──────────────────────────────────────────────────────
    // The three states an aircraft row can report. ⚠ These two are NOT invented:
    // they are the Photon logo's own dots (`assets/logo-v0.svg` and `logo-v1.svg`),
    // so the status colors are already part of the brand and already sit beside
    // the accent on every screen.
    out property <color> status-ok: #9fea7c;      // installed and current
    out property <color> status-broken: #f26951;  // install reverted - reinstall

    // ⚠ Badge text is NOT always white. The green is light enough that white on it
    // fails to read at 12 px, so the Green badge carries dark ink — and the design
    // uses the SCREEN BACKGROUND for it, not the near-black used on the text
    // field. The badge reads as a hole punched in the surface rather than as a
    // dark chip sitting on it.
    out property <color> badge-ink-dark: #495057;
    // The Badge component's fourth style, for a state with no color meaning.
    out property <color> badge-normal: #7e92a5;

    // Destructive actions (Uninstall). Shares the broken-install red because the
    // design does — one "this removes things" color, not two reds a shade apart.
    out property <color> danger: #f26951;

    // ─── button states ───────────────────────────────────────────────────────
    // Read out of the Button component set (`168:408 > Button`), which defines
    // Style x State for Primary / Normal / Danger. ⚠ THEY ARE NOT A UNIFORM
    // LIGHTEN: Primary hover jumps hue toward a brighter blue, Normal hover moves
    // toward blue from a grey, and both Primary and Danger keep their base fill on
    // press and darken with an inset shadow instead — while Normal actually
    // changes fill. Deriving these with brighter()/darker() got three of six wrong.
    out property <color> accent-hover: #2fa4ed;
    out property <color> neutral-hover: #88aed2;
    out property <color> neutral-down: #576d81;
    out property <color> danger-hover: #ff8c78;

    // The hovered button's lift. All three styles are `0 4px, blur 4` in Figma;
    // only the alpha differs. ⚠ THE COMPONENT SET'S CSS SHOWS TWO DIFFERENT BLUR
    // NUMBERS FOR ONE FIGMA VALUE — Primary and Danger come out as a CSS *filter*
    // `drop-shadow(0 4px 2px)` and Normal as a *box-shadow* `0 4px 4px`, because a
    // filter's third value is a standard deviation and a box-shadow's is a radius,
    // which is twice it. Slint's `drop-shadow-blur` is the box-shadow kind (its
    // own docs equate the two), so 4 px is right for all three and reading the
    // filter number literally makes Primary's shadow half the size it should be.
    out property <color> lift-strong: #00000026;   // 15% — Primary
    out property <color> lift-soft: #0000001c;     // 11% — Normal and Danger
    // A fourth alpha, for the wing radios. ⚠ ONLY THE ALPHA IS SHARED BETWEEN
    // THEIR TWO STATES — the offset and blur differ (checked `0 1px` blur 4,
    // unchecked `0 2px` blur 2) and are stated at the call site, because unlike
    // every lift above them these two are not one geometry at three strengths.
    out property <color> lift-faint: #0000001a;    // 10% — the wing radios

    // The hovered aircraft card's lift, `drop-shadow(0 2px 2px rgba(0,0,0,.12))`.
    // ⚠ THE FILTER'S 2 IS A σ, SO THE BLUR IS 4 — same trap as the buttons above,
    // and the reason this is a token rather than three numbers at the call site.
    out property <color> card-lift: #0000001f;     // 12%
    out property <length> card-lift-y: 2px;
    out property <length> card-lift-blur: 4px;

    // ─── inset shadows, APPROXIMATED ─────────────────────────────────────────
    // ⚠ SLINT'S REAL `inner-shadow-*` IS SKIA-ONLY AND THIS BUILD IS FEMTOVG, so
    // the properties compile and draw NOTHING — femtovg's item renderer returns
    // early on `box_shadow.inset()`. Switching renderers does not link: the
    // prebuilt Skia is /MD against this binary's /MT. See CMakeLists.txt and
    // docs/installer_gui_plan.md §6. These gradients are the stand-in, and they
    // are DERIVED rather than eyeballed: for a Gaussian of radius B (σ = B/2) the
    // alpha at an edge is the source alpha times Φ(offset/σ), decaying to zero
    // about B inside. Change the design value, redo the arithmetic.

    // The two panel wells: Figma `inset 0 1px 7px rgba(0,0,0,.25)`. The +1 offset
    // is why the top band is the strongest and the bottom the weakest.
    out property <brush> recess-top:
        @linear-gradient(180deg, #00000026 0%, #00000000 100%);   // .25·Φ(1/3.5)
    out property <brush> recess-bottom:
        @linear-gradient(0deg, #0000001a 0%, #00000000 100%);     // .25·Φ(-1/3.5)
    out property <brush> recess-left:
        @linear-gradient(90deg, #00000020 0%, #00000000 100%);    // .25·Φ(0)
    out property <brush> recess-right:
        @linear-gradient(270deg, #00000020 0%, #00000000 100%);
    out property <length> recess-top-h: 8px;
    out property <length> recess-bottom-h: 6px;
    out property <length> recess-side-w: 7px;

    // The pressed buttons: Figma `inset 0 4px 4px` at three alphas. A +4 offset
    // against a blur of 4 puts essentially all of it against the TOP edge
    // (Φ(4/2) ≈ .98) and none at the bottom, so one top-down band is not a
    // simplification here — it is the shape. Gone by ~9 px, i.e. 28% of 32.
    out property <brush> press-primary:
        @linear-gradient(180deg, #00000033 0%, #0000001f 12%, #00000000 28%);
    out property <brush> press-danger:
        @linear-gradient(180deg, #00000030 0%, #0000001d 12%, #00000000 28%);
    out property <brush> press-normal:
        @linear-gradient(180deg, #0000001a 0%, #00000010 12%, #00000000 28%);

    // The unselected aircraft card's edge glow: Figma `inset 0 0 4px` in WHITE,
    // .25 at rest and .6 under the pointer. ⚠ ZERO OFFSET, so unlike the two
    // above it is the SAME on all four edges — Φ(0) = ½ exactly — and `InsetGlow`
    // takes one color rather than four. .25·½ = .125 (0x20); .6·½ = .30 (0x4d).
    // Gone by 4 px, the blur radius.
    //
    // ⚠ A SELECTED CARD HAS NO GLOW. It takes the accent fill and the 2 px white
    // border instead, and Figma drops the inset shadow on that branch — stacking
    // the two puts a white haze just inside a white border.
    out property <color> card-glow: #ffffff20;
    out property <color> card-glow-hover: #ffffff4d;
    out property <length> card-glow-band: 4px;

    // ─── the large checkbox ──────────────────────────────────────────────────
    // Six variants (`194:634`), Checked x {Normal, Hover, Down}, added 2026-08-13.
    //
    // ⚠ EVERY FILL IT USES IS ALREADY ABOVE AND IS DELIBERATELY NOT RESTATED HERE:
    // unchecked walks the Normal button's states (`neutral-hover`, `neutral-down`)
    // and checked walks Primary's (`accent-hover`, and `accent` again on press,
    // because Primary keeps its fill and darkens with an inset instead). The one
    // place the box departs from the buttons is at REST, where unchecked is `muted`
    // and not `neutral` — a checkbox off is an inactive mark, which is what that
    // token is for. Its hover lift is `lift-soft`, the Normal button's own.
    // So what is new here is only the two treatments Slint cannot express directly.

    // The 1 px white line along the TOP INNER EDGE of a hovered box: Figma
    // `inset 0 1px 0`, at .30 unchecked and .35 checked.
    //
    // ⚠ THIS ONE IS EXACT, NOT AN APPROXIMATION, AND THAT IS WHY IT IS A COLOR
    // RATHER THAN A GRADIENT. The blur is ZERO, so there is no Gaussian to
    // integrate: an inset shadow of zero blur offset 1 px down is precisely the
    // 1 px strip the shifted shape leaves uncovered. Drawn as a 1 px band.
    out property <color> check-lip-unchecked: #ffffff4d;   // 30%
    out property <color> check-lip-checked: #ffffff59;     // 35%

    // Pressed. Same stand-in and same arithmetic as `press-*` above — but ⚠ THE
    // BUTTON GRADIENTS CANNOT BE REUSED, because their stops are percentages of a
    // 32 px button and this box is 20 px. Same shadow, same numbers, different
    // fractions; sharing the brush would put the decay in the wrong place.
    //
    //   unchecked  `inset 0 2px 3px rgba(0,0,0,.10)`, sigma 1.5
    //     .10·Phi(2/1.5) = .091 at the edge, .05 at d = 2 px (10%),
    //     gone by d = dy + 2·sigma = 5 px (25%).
    //     ⚠ SOFTENED FROM .37 (2026-08-13) — the geometry did not move, only the
    //     alpha, so the stop percentages are the ones already derived and only the
    //     three colors change. It also RETIRES the one real objection to the top
    //     band here: the sides carry Phi(0) = half the source, which at .37 was
    //     47/255 and is now 13/255, the same margin the radio's is accepted at.
    out property <brush> check-press-unchecked:
        @linear-gradient(180deg, #00000017 0%, #0000000d 10%, #00000000 25%);
    //   checked    `inset 0 4px 4px rgba(0,0,0,.25)`, sigma 2
    //     .25·Phi(2) = .244 at the edge, .125 at d = 4 px (20%),
    //     gone by d = 8 px (40%).
    out property <brush> check-press-checked:
        @linear-gradient(180deg, #0000003e 0%, #00000020 20%, #00000000 40%);

    // ─── the wing-mod radio ──────────────────────────────────────────────────
    // Six variants (`195:703`), added 2026-08-13 alongside the checkbox's.
    //
    // ⚠ NEARLY THE CHECKBOX'S AND NOT QUITE — do not fold the two together. It
    // takes the same six fills, but it has NO hover lip in any state, its
    // pressed-unchecked inset is a quarter the strength, its hover lift is a
    // different alpha AND a different geometry per state, and its LABEL goes
    // white on hover, not only when checked. Four differences, all of them
    // what `195:703` says.

    // Pressed, same stand-in and same derivation as `press-*` above.
    //
    // ⚠ THE CHECKED ONE IS THE CHECKBOX'S EXACT FIGMA SHADOW — `inset 0 4px 4px`
    // at .25, so the same three colors — AND STILL CANNOT SHARE ITS BRUSH. The
    // stops are fractions of the box's own height, and this box is 16 px against
    // the checkbox's 20 and the button's 32. Same shadow, three different sets of
    // percentages; that is the rule here, not a coincidence.
    //
    //   unchecked  `inset 0 1px 4px rgba(0,0,0,.10)`, sigma 2
    //     .10·Phi(0.5) = .069 at the edge, .05 at d = 1 px (6%),
    //     gone by d = dy + 2·sigma = 5 px (31%).
    //     ⚠ A TOP BAND ONLY, AND HERE THAT REALLY IS A SIMPLIFICATION. The
    //     pressed buttons get one because an offset of 2 sigma leaves nothing
    //     anywhere else; this offset is HALF a sigma, so the sides carry .05 and
    //     the bottom .031 as well. Both are under 13/255 against the fill they
    //     sit on, and keeping the top alone preserves the direction the offset
    //     exists to express. `WellRecess` is the four-band shape if it ever has
    //     to be exact.
    out property <brush> radio-press-unchecked:
        @linear-gradient(180deg, #00000012 0%, #0000000d 6%, #00000000 31%);
    //   checked    `inset 0 4px 4px rgba(0,0,0,.25)`, sigma 2
    //     .25·Phi(2) = .244 at the edge, .125 at d = 4 px (25%),
    //     gone by d = 8 px (50%).
    out property <brush> radio-press-checked:
        @linear-gradient(180deg, #0000003e 0%, #00000020 25%, #00000000 50%);

    // ─── focus ───────────────────────────────────────────────────────────────
    // ⚠ THE WHITE 2 px KEYLINE NOW MEANS FOCUS, AND ONLY FOCUS (2026-08-12). It
    // used to be Primary's permanent identity — Primary Default carried it and
    // thinned it to 1 px on hover. The design dropped it from every resting state
    // and added a Focus variant to all three styles that is nothing but the base
    // fill plus this border, which is what makes a focus ring legible at all:
    // a decoration that is always on cannot also be a state.
    //
    // ⚠ Its one overload is the SELECTED aircraft card, which the design also
    // draws with a 2 px white border. That is survivable only because the list
    // moves selection with the arrow keys rather than moving a separate cursor —
    // focus and selection are the same row there, so the border never has to say
    // two things at once. See screens/aircraft.slint.
    out property <length> focus-ring-w: 2px;
    // The ring drawn around controls the design has no Focus variant for — the
    // feature checkboxes and the wing radios. OUTSET rather than a border on the
    // control, because the control is a 20 px / 16 px glyph and a 2 px border on
    // one of those eats the glyph rather than marking it.
    out property <length> focus-ring-outset: 4px;

    // ─── type ────────────────────────────────────────────────────────────────
    // ⚠ ROBOTO IS NOT INSTALLED BY DEFAULT ON WINDOWS OR MACOS. Slint falls back to
    // a system font when it is missing, so the UI still lays out — it just is not
    // the design. Embedding the family is the fix; until then this is one string
    // to change. See the plan's open threads.
    out property <string> font: "Roboto";
    out property <string> font-mono: "Roboto Mono";

    out property <length> h1-size: 18px;          // "Where is X-Plane installed?"
    out property <length> h2-size: 14px;          // section heads, card titles
    out property <length> label-size: 12px;       // secondary lines

    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-black: 900;         // the UPDATE badge only

    // ─── metrics ─────────────────────────────────────────────────────────────
    // The window is 640x480 with a fixed rail and bar; those three numbers are the
    // frame every screen is written into.
    out property <length> window-w: 640px;
    out property <length> window-h: 480px;
    out property <length> sidebar-w: 158px;
    out property <length> bar-h: 64px;

    out property <length> content-pad-x: 20px;
    out property <length> content-pad-y: 24px;
    out property <length> content-gap: 10px;

    out property <length> button-w: 96px;
    out property <length> button-h: 32px;
    out property <length> card-h: 72px;
    // Reserved beside a ScrollView's content — Slint draws the bar OVER the
    // viewport rather than taking width from it. See screens/aircraft.slint.
    //
    // ⚠ IT IS THE CONTENT'S PADDING, NEVER THE SCROLLVIEW'S GEOMETRY. Slint pins
    // the bar to the ScrollView's own right edge, so insetting the VIEW to make
    // room insets the BAR by the same amount — which is how the thumb ended up
    // floating 16 px in from the well's border with an empty lane beside it. The
    // view fills the well; this keeps the rows out from under the bar. 18 px
    // clears the 14 px bar and leaves 8 px beside the 6 px hovered thumb.
    out property <length> scrollbar-gutter: 18px;

    // ─── the scroll bar ──────────────────────────────────────────────────────
    // ⚠ OURS, NOT std-widgets'. See `PhotonScrollView` for why it had to be.
    // The geometry is fluent's, kept deliberately so `scrollbar-gutter` above
    // still describes the truth: a 14 px lane with the thumb 4 px in from its
    // right edge.
    out property <length> scrollbar-w: 14px;
    out property <length> scroll-thumb-inset: 4px;
    out property <length> scroll-thumb-w: 2px;
    out property <length> scroll-thumb-w-active: 6px;
    // Short lists give a thumb nearly as tall as the track; long ones would give
    // a sliver too small to grab without this.
    out property <length> scroll-thumb-min: 24px;
    // ⚠ THE THUMB'S TRAVEL IS INSET FROM BOTH ENDS, so it stops short of the
    // container rather than running into its corners. It is the same idea as
    // fluent's 16 px `offset` — which exists to clear its two scroll buttons —
    // at the size that only has to clear a rounded edge.
    out property <length> scroll-track-inset: 4px;

    // ⚠ THE TRACK HAS NO COLOR AT ALL — there is deliberately no token for one.
    // fluent paints a dark rounded rectangle behind the thumb on hover, and it
    // clashed with every panel it sat in. The contrast that treatment was reaching
    // for is here instead, in the thumb: 8% white at rest (fluent's own resting
    // value, unchanged) going solid under the pointer.
    //
    // ⚠ `scroll-thumb-active` IS THE SAME VALUE AS `neutral` AND `badge-normal`
    // AND IS DELIBERATELY NOT AN ALIAS OF EITHER. Those two are a button fill and
    // a badge fill; this is a scrollbar. The file already carries that duplication
    // once on purpose, and the reason is the same both times — a retune of the
    // secondary button must not silently drag two unrelated controls with it.
    out property <color> scroll-thumb: #ffffff14;
    out property <color> scroll-thumb-active: #7e92a5;

    out property <length> radius: 4px;
    out property <length> radius-small: 2px;
    out property <length> radius-panel: 6px;
}
