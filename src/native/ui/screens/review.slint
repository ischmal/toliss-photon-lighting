// Screen 5 — does everything look correct?
//
// The last screen before anything is written. Four fixed properties, then a
// key/value list of whatever the install is actually going to do.
//
// ⚠ THE VALUES ARE RENDERED BY C++, not derived here. "Not installed -> v0.9" is a
// sentence about two manifest states and the UI has no business computing it.

import { Tokens } from "../tokens.slint";
import { Header1, Header2, MutedLabel, PropertyRow } from "../widgets.slint";

// The design's "Attribute" component: a muted key on the left, a bold uppercase
// value on the right, a hairline underneath.
export struct Attribute {
    label: string,
    value: string,
}

// ⚠ THE ROW IS 260 px WIDE AND INDENTED 10 px — it does NOT span the content.
// The design lays the Attributes frame out as 442x78 holding four 260x18 rows at
// x=10 on a 20 px pitch, i.e. 18 px of row and 2 px of gap. Stretching them full
// width put the values hard against the right edge of the pane, a long way from
// the labels they belong to, which is what made the list read as unaligned.
component AttributeRow inherits Rectangle {
    in property <Attribute> attribute;

    width: 260px;
    height: 18px;

    MutedLabel {
        x: 0;
        y: 0;
        width: parent.width / 2;
        height: 16px;
        text: root.attribute.label;
        overflow: elide;
    }

    Text {
        x: parent.width / 2;
        y: 0;
        width: parent.width / 2;
        height: 16px;
        text: root.attribute.value;
        color: Tokens.text;
        font-family: Tokens.font;
        font-size: Tokens.label-size;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    // The hairline sits UNDER the row, spanning its 260 px — not the pane.
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Tokens.muted;
    }
}

export component ReviewScreen inherits Rectangle {
    in property <string> xplane-root;
    in property <string> aircraft-folder;
    in property <string> aircraft-name;
    in property <string> version-transition;
    in property <[Attribute]> attributes;

    background: Tokens.screen-bg;

    VerticalLayout {
        spacing: Tokens.content-gap;
        padding-left: Tokens.content-pad-x;
        padding-right: Tokens.content-pad-x;
        padding-top: Tokens.content-pad-y;
        padding-bottom: Tokens.content-pad-y;
        alignment: start;

        Header1 {
            height: 40px;
            text: "Does everything look correct?";
        }

        PropertyRow {
            label: "X-Plane 12 Directory";
            value: root.xplane-root;
        }

        PropertyRow {
            label: "Aircraft Folder";
            value: root.aircraft-folder;
        }

        PropertyRow {
            label: "Identified Aircraft";
            value: root.aircraft-name;
        }

        PropertyRow {
            label: "ToLiss Photon Version";
            value: root.version-transition;
        }

        Header2 {
            height: 24px;
            text: "Selected Options";
            font-weight: Tokens.weight-medium;
        }

        // 10 px indent and a 20 px pitch (18 px row + 2 px gap), per the design.
        //
        // ⚠ WRAPPED IN A start-ALIGNED HorizontalLayout SO ITS FIXED WIDTH DOES NOT
        // SET THE COLUMN'S. A VerticalLayout takes its preferred width from its
        // widest child, and these rows are a hard 260 px — so the whole Review
        // column collapsed to ~270 px, and the X-Plane path in the PropertyRow
        // above elided at half the space it actually had. The wrapper absorbs the
        // fixed width and reports "as wide as you like" upward. Same fix as the
        // Complete screen's 215 px button stack.
        HorizontalLayout {
            alignment: start;

            VerticalLayout {
                alignment: start;
                spacing: 2px;
                padding-left: 10px;

                for attribute in root.attributes: AttributeRow {
                    attribute: attribute;
                }
            }
        }
    }
}
